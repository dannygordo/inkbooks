{
  "expo": {
    "name": "InkBooks",
    "slug": "inkbooks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inkbooks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.inkbooks.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "InkBooks uses Bluetooth to connect to a Square card reader so you can take payments in person.",
        "NSLocationWhenInUseUsageDescription": "InkBooks uses your location to confirm in-person card payments happen at a supported location, as required by Square.",
        "NSMicrophoneUsageDescription": "Some Square card readers use the microphone port to communicate card data to your device."
      }
    },
    "android": {
      "package": "net.inkbooks.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "READ_PHONE_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 28,
            "extraMavenRepos": [
              "https://sdk.squareup.com/public/android/"
            ]
          }
        }
      ],
      "./plugins/withSquareKotlinCompat",
      "./plugins/withSquareIosSetup",
      "./plugins/withSquareSdkInitialize"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9add6b59-0cef-46d2-91aa-b2eea400ed83"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9add6b59-0cef-46d2-91aa-b2eea400ed83"
    }
  }
}
